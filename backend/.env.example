# Server
PORT=5000/8080
NODE_ENV=development/production

# Auth - node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=


# Database
MONGO_URI=

#Email info 
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cookies
COOKIE_SECURE=false/true
COOKIE_SAMESITE=strict/none

# CORS (comma-separated origins, e.g. your Next.js and Expo web apps)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Seed Admin (used with `npm run seed:admin`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User

# Rate limiting (set to "false" to disable, e.g. during local testing)
RATE_LIMIT_ENABLED=false/true

# Guest order OTP (SMS) — optional; without a token, OTPs fall back to the log
IPROG_SMS_API_TOKEN=
IPROG_SMS_API_BASE_URL=https://www.iprogsms.com/api/v1
IPROG_SMS_PROVIDER=2
GUEST_OTP_CODE_MINUTES=5
GUEST_OTP_VERIFIED_DAYS=30